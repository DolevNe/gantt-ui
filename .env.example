# --- Used by the dev server proxy only (never shipped to the browser) ---
JIRA_URL=https://jira.example.local
# Set to false if Jira uses an internal CA that Node does not trust
JIRA_TLS_VERIFY=true

# --- Baked into the browser bundle at build time ---
# Path the app calls; the dev proxy / nginx forwards it to JIRA_URL
VITE_JIRA_API_BASE=/jira
# Board whose sprints are listed (the number in rapidView=… in the board URL)
VITE_JIRA_BOARD_ID=123
# Project that stores the shared Gantt settings (display names, row order, shown items)
VITE_JIRA_PROJECT_KEY=CASTLE
# Name of the date-picker custom field used as the start date
VITE_JIRA_START_DATE_FIELD=Start date
